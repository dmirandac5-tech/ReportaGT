# Copia este archivo a .env y ajusta los valores:  cp .env.example .env

PORT=3000
# URL pública base (se usa para enlaces/fotos en los correos)
BASE_URL=http://localhost:3000

# Correo de la municipalidad que recibe los reportes
MUNI_EMAIL=muni@villacanales.test
# Remitente que ven los vecinos y la muni
MAIL_FROM="ReportaGT <reportagt@villacanales.test>"

# --- SMTP local con Mailpit (por defecto) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# --- Para usar Gmail real más adelante (sin tocar código) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=tucuenta@gmail.com
# SMTP_PASS=contraseña-de-aplicacion-de-16-letras
# MAIL_FROM="ReportaGT <tucuenta@gmail.com>"
